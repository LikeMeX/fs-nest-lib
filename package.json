{
  "name": "@likemex/fs-nest-lib",
  "version": "1.0.23",
  "description": "NestJS library: OpenTelemetry OTLP setup and Pino logger module with trace correlation",
  "author": "LikeMeX",
  "license": "MIT",
  "homepage": "https://github.com/LikeMeX/fs-nest-lib#readme",
  "repository": {
    "type": "git",
